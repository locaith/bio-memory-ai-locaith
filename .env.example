AGENT_NAME=Bio-AI
STORAGE_DIR=data

# Encryption key for persona rules. Leave empty to auto-generate a
# per-install key in <STORAGE_DIR>/.bio_agent_secret.json.
BIO_AGENT_SECRET_KEY=

# Admin API key required as "Authorization: Bearer <key>" on every endpoint
# except / and /api/health. Leave empty only for loopback-only development.
BIO_AGENT_API_KEY=

# Optional tenant keys with workspace scopes, e.g.:
#   BIO_AGENT_TENANT_KEYS=key-a=ws-alpha|ws-beta,key-b=ws-gamma
# Tenant keys can only use data-plane endpoints (chat/ingest/retrieve/
# lineage/episodes/exact-memories) inside their own workspaces.
BIO_AGENT_TENANT_KEYS=

# Requests per minute per client IP. 0 disables rate limiting.
BIO_AGENT_RATE_LIMIT=120

# Comma-separated CORS origins. Defaults to localhost origins when empty.
BIO_AGENT_CORS_ORIGINS=

BIO_AGENT_DB_BACKEND=sqlite
BIO_AGENT_DATABASE_URL=
BIO_AGENT_CONFLICT_DETECTOR=hybrid
POSTGRES_DB=bio_agent_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Bind address for serve-api. Keep loopback unless BIO_AGENT_API_KEY is set.
HOST=127.0.0.1
PORT=8055

# Generic runtime
LLM_BACKEND=gemini
MODEL_ID=gemini-3-flash-preview
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.3

# Gemini
GEMINI_API_KEY=

# OpenAI or any OpenAI-compatible local server
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8000/v1

# Anthropic / Claude
ANTHROPIC_API_KEY=

# xAI / Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
